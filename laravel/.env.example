###############################################################################
# Portal Kelulusan SMKN 1 Wonogiri — environment template
#
# COPY this file to `.env` and fill in the values for your hosting environment.
# After editing, visit:
#     https://<your-domain>/api/deploy/setup?token=<DEPLOY_TOKEN>
# to run migrations + create the storage symlink in one click (no terminal).
###############################################################################

APP_NAME="Portal Kelulusan SMKN 1 Wonogiri"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# IMPORTANT — set this to the canonical URL the site is reachable at.
# This single value drives `Storage::url()`, `asset()`, and every link the
# backend generates. The frontend never needs to know the domain because it
# uses `window.location.origin` at runtime.
#
#   • Replit:  APP_URL=https://your-repl-name.your-handle.replit.dev
#   • cPanel:  APP_URL=https://kelulusan.smkn1wonogiri.sch.id
#
APP_URL=http://localhost

# One-click deploy guard. Pick a long random string; the /api/deploy/setup
# endpoint will refuse to run unless this matches the `?token=` query param.
DEPLOY_TOKEN=ganti-dengan-string-random-panjang

# Database — defaults shown for typical cPanel MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kelulusan
DB_USERNAME=root
DB_PASSWORD=

# Filesystem
FILESYSTEM_DISK=public

# Session / cache (file driver works on every shared host out-of-the-box)
SESSION_DRIVER=file
CACHE_DRIVER=file

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning
